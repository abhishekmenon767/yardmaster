/vendor
/node_modules
/build
# composer.lock is not committed: this is a library, so the application's own
# lock file decides versions. package-lock.json *is* committed — CI builds
# dist/ with `npm ci`, which requires it, and pinning the toolchain is what
# makes the committed bundle reproducible.
composer.lock
.phpunit.result.cache
.phpunit.cache
.DS_Store

# dist/ is intentionally committed: an application installs the package with
# composer and gets a working dashboard, with no npm step on their side.

# Local workbench state: a developer's own demo database and environment.
/workbench/.env
/workbench/database/*.sqlite
/workbench/database/migrations
